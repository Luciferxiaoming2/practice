// --- Components ---

// 1. Login Screen
const LoginScreen = ({ onLogin }) => {
  const [isAnimating, setIsAnimating] = useState(false);

  const handleLogin = (e) => {
    e.preventDefault();
    setIsAnimating(true);
    setTimeout(() => {
      onLogin();
    }, 800);
  };

  return (
    <div className="flex flex-col h-full bg-white text-slate-900 p-8 relative overflow-hidden">
      {/* Background decoration - Light soft gradients */}
      <div className="absolute top-[-10%] left-[-20%] w-96 h-96 bg-purple-200/50 rounded-full blur-3xl pointer-events-none"></div>
      <div className="absolute bottom-[-10%] right-[-20%] w-96 h-96 bg-fuchsia-200/50 rounded-full blur-3xl pointer-events-none"></div>

      <div className="flex-1 flex flex-col justify-center relative z-10">
        <div className="mb-12">
          <h1 className="text-4xl font-light tracking-widest mb-2 text-slate-800">END<span className="font-bold text-purple-600">PAGE</span></h1>
          <h2 className="text-xl text-slate-500 font-light tracking-wider">熵析云枢打卡系统</h2>
        </div>

        <form onSubmit={handleLogin} className="space-y-6">
          <div className="space-y-2">
            <label className="text-sm font-medium text-slate-600 pl-1">工号 / 账号</label>
            <input
              type="text"
              defaultValue="EP-10024"
              className="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-4 text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-purple-400 focus:ring-4 focus:ring-purple-500/10 transition-all shadow-sm"
            />
          </div>
          <div className="space-y-2">
            <label className="text-sm font-medium text-slate-600 pl-1">密码</label>
            <input
              type="password"
              defaultValue="••••••••"
              className="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-4 text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-purple-400 focus:ring-4 focus:ring-purple-500/10 transition-all shadow-sm"
            />
          </div>

          <button
            type="submit"
            className={`w-full bg-purple-600 hover:bg-purple-700 text-white rounded-2xl py-4 font-medium tracking-wider shadow-[0_4px_14px_0_rgba(147,51,234,0.39)] hover:shadow-[0_6px_20px_rgba(147,51,234,0.23)] transition-all flex justify-center items-center ${isAnimating ? 'opacity-80 scale-95' : ''}`}
          >
            {isAnimating ? (
              <div className="w-6 h-6 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
            ) : (
              '验证登录'
            )}
          </button>
        </form>
      </div>

      <div className="text-center text-xs text-slate-500 pb-4 relative z-10 font-medium">
        <p>首次登录系统将强制要求修改密码及录入人脸</p>
      </div>
    </div>
  );
};

// 2. Home/Dashboard Screen
const HomeScreen = ({ onCheckInSuccess }) => {
  const [time, setTime] = useState(new Date());
  const [checkInState, setCheckInState] = useState('idle'); // idle, scanning, success

  useEffect(() => {
    const timer = setInterval(() => setTime(new Date()), 1000);
    return () => clearInterval(timer);
  }, []);

  const handleCheckIn = () => {
    if (checkInState !== 'idle') return;

    setCheckInState('scanning');

    // Simulate face scan and network request
    setTimeout(() => {
      setCheckInState('success');
      setTimeout(() => {
        setCheckInState('idle');
        onCheckInSuccess(time);
      }, 2000);
    }, 2500);
  };

  const formattedTime = time.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  const formattedDate = time.toLocaleDateString('zh-CN', { month: 'long', day: 'numeric', weekday: 'long' });

  return (
    <div className="flex flex-col h-full bg-slate-50 text-slate-900 relative overflow-hidden">
      {/* Map Background Area (Top Half) */}
      <div className="absolute top-0 left-0 w-full h-[55%] bg-slate-200 z-0">
        <div className="w-full h-full relative">
          <iframe
            width="100%"
            height="100%"
            frameBorder="0"
            scrolling="no"
            marginHeight="0"
            marginWidth="0"
            src="https://www.openstreetmap.org/export/embed.html?bbox=113.93%2C22.53%2C113.95%2C22.55&amp;layer=mapnik&amp;marker=22.54%2C113.94"
            className="grayscale opacity-70"
            title="打卡地图"
          ></iframe>
          {/* Overlay to blend map, prevent iframe interactions, and add theme color */}
          <div className="absolute inset-0 bg-purple-600/5 mix-blend-multiply pointer-events-none"></div>
          <div className="absolute inset-0 bg-gradient-to-b from-white/60 via-transparent to-slate-50 pointer-events-none"></div>

          {/* Decorative Location Pin on Map */}
          <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-[80%] z-10 pointer-events-none flex flex-col items-center animate-bounce">
            <div className="bg-purple-600 text-white text-[10px] font-bold px-3 py-1 rounded-full shadow-lg mb-1 relative">
              打卡范围
              <div className="absolute -bottom-1 left-1/2 -translate-x-1/2 border-4 border-transparent border-t-purple-600"></div>
            </div>
          </div>
          {/* Map Range Circle */}
          <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-purple-500/10 border border-purple-500/30 rounded-full pointer-events-none"></div>
        </div>
      </div>

      {/* Header (Floating over Map) */}
      <div className="pt-12 px-6 pb-6 flex justify-between items-center relative z-10">
        <div className="bg-white/80 backdrop-blur-md px-4 py-2 rounded-2xl shadow-sm border border-white/50">
          <h2 className="text-xs font-bold text-purple-600 mb-0.5">早安，张宇航</h2>
          <h1 className="text-xl font-bold tracking-tight text-slate-800">研发中心</h1>
        </div>
        <div className="w-10 h-10 rounded-full bg-white/90 backdrop-blur-md border border-white/50 shadow-sm flex items-center justify-center relative hover:bg-white transition-colors cursor-pointer">
          <Bell size={18} className="text-slate-700" />
          <div className="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></div>
        </div>
      </div>

      {/* Bottom Sheet Area */}
      <div className="absolute bottom-0 left-0 w-full h-[55%] bg-white rounded-t-[2.5rem] shadow-[0_-15px_40px_-10px_rgba(0,0,0,0.1)] z-20 flex flex-col items-center px-6 pt-16 pb-6 border-t border-slate-100">

        {/* Check-in Button (Overlapping Map and Bottom Sheet) */}
        <div className="absolute -top-20 left-1/2 -translate-x-1/2 flex items-center justify-center w-40 h-40">
          {/* Ripple Effects */}
          {checkInState === 'idle' && (
            <>
              <div className="absolute inset-0 rounded-full border-2 border-purple-200 animate-[ping_3s_cubic-bezier(0,0,0.2,1)_infinite]"></div>
              <div className="absolute inset-2 rounded-full border-2 border-purple-100 animate-[ping_3s_cubic-bezier(0,0,0.2,1)_1s_infinite]"></div>
            </>
          )}

          <button
            onClick={handleCheckIn}
            disabled={checkInState !== 'idle'}
            className={`relative z-10 w-32 h-32 rounded-full flex flex-col items-center justify-center transition-all duration-500
              ${checkInState === 'idle'
                ? 'bg-white border-[6px] border-white shadow-[0_10px_30px_-10px_rgba(147,51,234,0.4)] hover:shadow-[0_15px_40px_-10px_rgba(147,51,234,0.5)] hover:scale-105'
                : checkInState === 'success'
                  ? 'bg-emerald-50 border-[6px] border-white shadow-[0_10px_30px_-10px_rgba(16,185,129,0.4)] scale-105'
                  : 'bg-purple-50 border-[6px] border-white shadow-[0_10px_30px_-10px_rgba(147,51,234,0.5)] scale-105'
              }`}
          >
            {checkInState === 'idle' && (
              <>
                <div className="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center mb-1">
                  <ScanFace size={24} className="text-purple-600" strokeWidth={2} />
                </div>
                <span className="text-sm font-bold tracking-wide text-slate-800">立即打卡</span>
              </>
            )}

            {checkInState === 'scanning' && (
              <>
                <div className="absolute inset-2 rounded-full overflow-hidden">
                  <div className="w-full h-1 bg-purple-500 shadow-[0_0_10px_rgba(147,51,234,0.5)] animate-[scan_1.5s_ease-in-out_infinite]"></div>
                </div>
                <ScanFace size={28} className="text-purple-400 mb-2 animate-pulse" strokeWidth={1.5} />
                <span className="text-xs font-bold tracking-widest text-purple-600 animate-pulse">检测中</span>
              </>
            )}

            {checkInState === 'success' && (
              <>
                <div className="w-12 h-12 bg-emerald-100 rounded-full flex items-center justify-center mb-1">
                  <CheckCircle2 size={28} className="text-emerald-500" strokeWidth={2.5} />
                </div>
                <span className="text-sm font-bold text-emerald-600 tracking-wide">已打卡</span>
              </>
            )}
          </button>
        </div>

        {/* Main Clock Area */}
        <div className="text-center mb-6 mt-2">
          <div className="text-5xl font-light tracking-tight mb-1 text-slate-800" style={{ fontVariantNumeric: 'tabular-nums' }}>
            {formattedTime}
          </div>
          <div className="text-xs font-medium text-purple-600 bg-purple-50 px-3 py-1 rounded-full inline-block">{formattedDate}</div>
        </div>

        {/* Requirements Status Cards */}
        <div className="w-full mt-auto grid grid-cols-3 gap-3">
          <div className="bg-slate-50 border border-slate-100 shadow-sm rounded-2xl p-3 flex flex-col items-center justify-center relative overflow-hidden group hover:bg-emerald-50/50 hover:border-emerald-200 transition-all">
            <div className="w-8 h-8 rounded-full bg-white shadow-sm flex items-center justify-center mb-2 group-hover:bg-emerald-100 transition-colors">
              <MapPin size={16} className="text-emerald-600" />
            </div>
            <span className="text-[11px] font-medium text-slate-600 mb-1.5">定位围栏</span>
            <span className="text-[10px] font-bold text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded-full">已在范围内</span>
          </div>

          <div className="bg-slate-50 border border-slate-100 shadow-sm rounded-2xl p-3 flex flex-col items-center justify-center relative overflow-hidden group hover:bg-emerald-50/50 hover:border-emerald-200 transition-all">
            <div className="w-8 h-8 rounded-full bg-white shadow-sm flex items-center justify-center mb-2 group-hover:bg-emerald-100 transition-colors">
              <Clock size={16} className="text-emerald-600" />
            </div>
            <span className="text-[11px] font-medium text-slate-600 mb-1.5">时间窗口</span>
            <span className="text-[10px] font-bold text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded-full">08:00-10:00</span>
          </div>

          <div className="bg-slate-50 border border-slate-100 shadow-sm rounded-2xl p-3 flex flex-col items-center justify-center relative overflow-hidden group hover:bg-purple-50/50 hover:border-purple-200 transition-all">
            <div className="w-8 h-8 rounded-full bg-white shadow-sm flex items-center justify-center mb-2 group-hover:bg-purple-100 transition-colors">
              <ShieldCheck size={16} className="text-purple-600" />
            </div>
            <span className="text-[11px] font-medium text-slate-600 mb-1.5">人脸验证</span>
            <span className="text-[10px] font-bold text-purple-700 bg-purple-100/80 px-2 py-0.5 rounded-full">要求活体</span>
          </div>
        </div>
      </div>

      {/* CSS for custom animations */}
      <style dangerouslySetInnerHTML={{__html: `
        @keyframes scan {
          0% { transform: translateY(-40px); }
          50% { transform: translateY(120px); }
          100% { transform: translateY(-40px); }
        }
      `}} />
    </div>
  );
};

