// --- Main App Container ---
export default function App() {
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const [activeTab, setActiveTab] = useState('home'); // home, records, profile

  // Mock Data
  const [records, setRecords] = useState([
    { date: '3月26日', time: '08:45', status: 'normal', location: '科技创新园 A栋', device: 'iPhone 15 Pro' },
    { date: '3月26日', time: '18:30', status: 'normal', location: '科技创新园 A栋', device: 'iPhone 15 Pro' },
    { date: '3月25日', time: '09:15', status: 'late', location: '科技创新园 A栋', device: 'iPhone 15 Pro' },
    { date: '3月25日', time: '18:05', status: 'normal', location: '科技创新园 A栋', device: 'iPhone 15 Pro' },
  ]);

  const handleLogin = () => setIsLoggedIn(true);
  const handleLogout = () => {
    setIsLoggedIn(false);
    setActiveTab('home');
  };

  const handleCheckInSuccess = (timeObj) => {
    const newRecord = {
      date: `${timeObj.getMonth() + 1}月${timeObj.getDate()}日`,
      time: timeObj.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }),
      status: 'normal',
      location: '科技创新园 A栋 (当前位置)',
      device: '当前设备'
    };
    setRecords([newRecord, ...records]);
  };

  return (
    <div className="min-h-screen bg-slate-200 flex items-center justify-center p-4 font-sans sm:bg-[url('https://images.unsplash.com/photo-1557682250-33bd709cbe85?q=80&w=2000&auto=format&fit=crop')] bg-cover bg-center">

      {/* Mobile Device Mockup Container - Light Silver Theme */}
      <div className="w-full max-w-[400px] h-[850px] bg-white rounded-[3rem] shadow-2xl overflow-hidden relative border-[8px] border-slate-100 flex flex-col sm:max-h-[85vh] ring-1 ring-slate-900/5">

        {/* Phone Notch/Dynamic Island simulation */}
        <div className="absolute top-0 inset-x-0 h-7 flex justify-center z-50">
          <div className="w-32 h-6 bg-slate-900 rounded-b-2xl mt-[-2px] shadow-sm"></div>
        </div>

        {/* Screen Content */}
        <div className="flex-1 overflow-hidden relative bg-slate-50">
          {!isLoggedIn ? (
            <LoginScreen onLogin={handleLogin} />
          ) : (
            <>
              {activeTab === 'home' && <HomeScreen onCheckInSuccess={handleCheckInSuccess} />}
              {activeTab === 'records' && <RecordsScreen records={records} />}
              {activeTab === 'profile' && <ProfileScreen onLogout={handleLogout} />}
            </>
          )}
        </div>

        {/* Bottom Navigation Bar */}
        {isLoggedIn && (
          <div className="h-20 bg-white/90 backdrop-blur-xl border-t border-slate-200 flex items-center justify-around px-2 pb-2 z-40 relative shadow-[0_-4px_20px_rgba(0,0,0,0.02)]">
            <button
              onClick={() => setActiveTab('home')}
              className={`flex flex-col items-center justify-center w-16 h-12 transition-all ${activeTab === 'home' ? 'text-purple-600 scale-110' : 'text-slate-400 hover:text-purple-400'}`}
            >
              <Home size={22} strokeWidth={activeTab === 'home' ? 2.5 : 2} className="mb-1" />
              <span className="text-[10px] font-bold">打卡</span>
            </button>
            <button
              onClick={() => setActiveTab('records')}
              className={`flex flex-col items-center justify-center w-16 h-12 transition-all ${activeTab === 'records' ? 'text-purple-600 scale-110' : 'text-slate-400 hover:text-purple-400'}`}
            >
              <History size={22} strokeWidth={activeTab === 'records' ? 2.5 : 2} className="mb-1" />
              <span className="text-[10px] font-bold">记录</span>
            </button>
            <button
              onClick={() => setActiveTab('profile')}
              className={`flex flex-col items-center justify-center w-16 h-12 transition-all ${activeTab === 'profile' ? 'text-purple-600 scale-110' : 'text-slate-400 hover:text-purple-400'}`}
            >
              <User size={22} strokeWidth={activeTab === 'profile' ? 2.5 : 2} className="mb-1" />
              <span className="text-[10px] font-bold">我的</span>
            </button>
          </div>
        )}
      </div>
    </div>
  );
}